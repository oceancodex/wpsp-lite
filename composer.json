{
	"name": "oceancodex/wpsp-lite",
	"version": "12.1.70",
	"description": "WPSP Framework - WordPress Starter Plugin - Lite",
	"keywords": [
		"wordpress plugin",
		"wordpress starter plugin",
		"starter plugin",
		"starter",
		"wordpress",
		"plugin",
		"oceancodex",
		"wpsp",
		"wordpress framework",
		"wordpress plugin framework"
	],
	"license": "GPL-2.0-or-later",
	"require": {
		"php": "^8.2",
		"ext-fileinfo": "*",
		"ext-intl": "*",
		"ext-json": "*",
		"ext-mbstring": "*",
		"ext-mysqli": "*",
		"ext-pdo": "*",
		"oceancodex/wpsp-core-lite": "^12.0"
	},
	"require-dev": {
		"phpunit/phpunit": "^11.5"
	},
	"repositories": [
		{
			"url": "../wpsp-core-lite",
			"type": "path",
			"options": {
				"symlink": true
			}
		}
	],
	"autoload": {
		"psr-4": {
			"WPSPLITE\\": "",
			"WPSPLITE\\App\\": "app/",
			"WPSPLITE\\Tests\\": "tests/",
			"WPSPLITE\\Routes\\": "routes/"
		},
		"files": [
			"app/Helpers/Helpers.php"
		],
		"exclude-from-classmap": [
			"node_modules/"
		]
	},
	"autoload-dev": {
		"psr-4": {
			"WPSPLITE\\Tests\\": "tests/"
		}
	},
	"authors": [
		{
			"name": "OceanCodex",
			"email": "contact@oceancodex.com"
		}
	],
	"scripts": {
		"setup": [],
		"dev": [],
		"test": [
			"@php artisan config:clear --ansi @no_additional_args",
			"@php artisan test"
		],
		"post-install-cmd": [
			"@php -r \"@unlink('bootstrap/cache/services.php'); @unlink('bootstrap/cache/packages.php');\""
		],
		"post-update-cmd": [
			"@php -r \"@unlink('bootstrap/cache/services.php'); @unlink('bootstrap/cache/packages.php');\""
		],
		"post-autoload-dump": [],
		"post-root-package-install": [],
		"post-create-project-cmd": [],
		"pre-package-uninstall": []
	},
	"config": {
		"sort-packages": true,
		"optimize-autoloader": true,
		"apcu-autoloader": true,
		"preferred-install": "dist",
		"allow-plugins": {
			"pestphp/pest-plugin": true,
			"php-http/discovery": true
		},
		"autoloader-suffix": "_wpsp_lite_1719507008"
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
