#===============================================================================
#  WPSP - Environment file
#===============================================================================
WPSP_LITE_APP_NAME="WPSP Framework - WordPress Starter Plugin - Lite"
WPSP_LITE_APP_SHORT_NAME="wpsp"
WPSP_LITE_APP_MODE="lite"
WPSP_LITE_DIR_NAME="wpsp"
WPSP_LITE_APP_KEY=base64:7xF5z6Z20QVMJrcNUCPvpx2mJq6TrQ7xmVVZI28vQcY=

#===============================================================================
# ENVIRONMENT
#===============================================================================
WPSP_LITE_APP_ENV="local"                     # local|dev|staging|production
WPSP_LITE_APP_PATH="/wp-content/plugins/${WPSP_LITE_DIR_NAME}"
WPSP_LITE_APP_URL="https://wordpress.local"
WPSP_LITE_APP_URL_FROM_PUBLIC="https://wpsp.local"
WPSP_LITE_ASSET_URL="/wp-content/plugins/${WPSP_LITE_DIR_NAME}/public"
WPSP_LITE_ASSET_ORIGINAL_URL="/"

#===============================================================================
# DEBUG OPTIONS
#===============================================================================
WPSP_LITE_APP_DEBUG=false
WPSP_LITE_APP_DEBUG_HANDLER=""				# empty|ignition
WPSP_LITE_APP_DEBUG_MONITOR=false
WPSP_LITE_APP_DEBUG_TYPE="advanced"			# simple|advanced
WPSP_LITE_APP_DEBUG_THEME="auto"				# auto|dark|light
WPSP_LITE_APP_DEBUG_EDITOR="phpstorm"		# clipboard|sublime|textmate|idea|...
WPSP_LITE_APP_DEBUG_LIVE_RELOAD=false

#===============================================================================
# LOCALIZATION
#===============================================================================
WPSP_LITE_APP_LOCALE=vi
WPSP_LITE_APP_FALLBACK_LOCALE=en
WPSP_LITE_APP_FAKER_LOCALE=vi_VN
WPSP_LITE_APP_TIMEZONE="UTC"

#===============================================================================
# MAINTENANCE
#===============================================================================
WPSP_LITE_APP_MAINTENANCE_DRIVER=file
# WPSP_LITE_APP_MAINTENANCE_STORE=database

#===============================================================================
# PHP CLI SERVER WORKERS
#===============================================================================
# PHP_CLI_SERVER_WORKERS=4

#===============================================================================
# HASHING
#===============================================================================
WPSP_LITE_HASH_DRIVER="bcrypt"               # bcrypt|argon
WPSP_LITE_BCRYPT_ROUNDS=12

#===============================================================================
# LOGGING
#===============================================================================
WPSP_LITE_LOG_CHANNEL=stack
WPSP_LITE_LOG_STACK=single
WPSP_LITE_LOG_DEPRECATIONS_CHANNEL=null
WPSP_LITE_LOG_LEVEL=debug

#===============================================================================
# DATABASE (MySQL / MariaDB)
#===============================================================================
WPSP_LITE_DB_TABLE_PREFIX="wpsp_lite"
WPSP_LITE_DB_CONNECTION="wp_wpsp"

WPSP_LITE_DB_HOST="localhost"
WPSP_LITE_DB_PORT="3306"
#WPSP_LITE_DB_SOCKET="/Users/.../Library/Application Support/Local/run/.../mysql/mysqld.sock" # Nếu bạn dùng MacOS và LocalWP thì cần khai báo socket.
WPSP_LITE_DB_DATABASE="database/database.sqlite"
WPSP_LITE_DB_USERNAME="root"
WPSP_LITE_DB_PASSWORD="root"
WPSP_LITE_DB_CHARSET="utf8mb4"

#===============================================================================
# MONGODB
#===============================================================================
WPSP_LITE_DB_MONGODB_HOST="localhost"
WPSP_LITE_DB_MONGODB_PORT="27017"
WPSP_LITE_DB_MONGODB_DATABASE="wpsp_lite_mongodb_database"
WPSP_LITE_DB_MONGODB_USERNAME=""
WPSP_LITE_DB_MONGODB_PASSWORD=""
WPSP_LITE_DB_MONGODB_AUTHENTICATION_DATABASE=""

#===============================================================================
# REDIS / MEMCACHED / CACHE
#===============================================================================
WPSP_LITE_CACHE_STORE="database"
# WPSP_LITE_CACHE_PREFIX="wpsp-lite-cache-"

#--- Redis Base ---#
WPSP_LITE_REDIS_CLIENT="phpredis"
WPSP_LITE_REDIS_URL=
WPSP_LITE_REDIS_HOST="127.0.0.1"
WPSP_LITE_REDIS_USERNAME=
WPSP_LITE_REDIS_PASSWORD=
WPSP_LITE_REDIS_PORT=6379
WPSP_LITE_REDIS_PREFIX="wpsp_lite"
WPSP_LITE_REDIS_DB=0

#--- Redis Options ---#
WPSP_LITE_REDIS_CLUSTER="redis"
WPSP_LITE_REDIS_PERSISTENT=false
WPSP_LITE_REDIS_MAX_RETRIES=3
WPSP_LITE_REDIS_BACKOFF_ALGORITHM="decorrelated_jitter"
WPSP_LITE_REDIS_BACKOFF_BASE=100
WPSP_LITE_REDIS_BACKOFF_CAP=1000

#--- Redis Dedicated DBs ---#
WPSP_LITE_REDIS_CACHE_DB=1
WPSP_LITE_REDIS_QUEUE_DB=2

#--- Memcached ---#
WPSP_LITE_MEMCACHED_HOST=127.0.0.1
WPSP_LITE_MEMCACHED_PORT=11211
WPSP_LITE_MEMCACHED_USER=
WPSP_LITE_MEMCACHED_PASSWORD=

#===============================================================================
# QUEUE
#===============================================================================
WPSP_LITE_QUEUE_CONNECTION="database"        # sync|database|redis
WPSP_LITE_DB_QUEUE_CONNECTION="wp_wpsp"      # Nếu bạn muốn queue trên MySQL
WPSP_LITE_QUEUE_RETRY_AFTER=90
WPSP_LITE_QUEUE_BLOCK_FOR=0

#===============================================================================
# BROADCAST
#===============================================================================
WPSP_LITE_BROADCAST_CONNECTION="reverb"		# reverb|pusher|ably|redis|log|null

#===============================================================================
# RATE LIMIT
#===============================================================================
WPSP_LITE_RATE_LIMITER_STORE="database"      # redis|database|array

#===============================================================================
# FILESYSTEMS
#===============================================================================
WPSP_LITE_FILESYSTEM_DISK="local"            # local|public|s3
WPSP_LITE_FILESYSTEM_CLOUD="s3"              # optional

#===============================================================================
# MAIL
#===============================================================================
WPSP_LITE_MAIL_MAILER="smtp"
WPSP_LITE_MAIL_SCHEME=
WPSP_LITE_MAIL_HOST="smtp.gmail.com"
WPSP_LITE_MAIL_PORT=587
WPSP_LITE_MAIL_USERNAME=""
WPSP_LITE_MAIL_PASSWORD=""
WPSP_LITE_MAIL_ENCRYPTION="tls"
WPSP_LITE_MAIL_FROM_ADDRESS="hello@example.com"
WPSP_LITE_MAIL_FROM_NAME="${WPSP_LITE_APP_NAME}"

#===============================================================================
# AWS S3
#===============================================================================
WPSP_LITE_AWS_ACCESS_KEY_ID=
WPSP_LITE_AWS_SECRET_ACCESS_KEY=
WPSP_LITE_AWS_DEFAULT_REGION="us-east-1"
WPSP_LITE_AWS_BUCKET=
WPSP_LITE_AWS_USE_PATH_STYLE_ENDPOINT=false

#===============================================================================
# REVERB (WebSockets)
#===============================================================================
WPSP_LITE_REVERB_APP_ID=371572
WPSP_LITE_REVERB_APP_KEY=esraab1uvp6pvqt0gqhk
WPSP_LITE_REVERB_APP_SECRET=wca98ywtk8dobktr6kdd
WPSP_LITE_REVERB_HOST="localhost"
WPSP_LITE_REVERB_PORT=8080
WPSP_LITE_REVERB_SCHEME=http

VITE_WPSP_LITE_REVERB_APP_KEY="${WPSP_LITE_REVERB_APP_KEY}"
VITE_WPSP_LITE_REVERB_HOST="${WPSP_LITE_REVERB_HOST}"
VITE_WPSP_LITE_REVERB_PORT="${WPSP_LITE_REVERB_PORT}"
VITE_WPSP_LITE_REVERB_SCHEME="${WPSP_LITE_REVERB_SCHEME}"

#===============================================================================
# PUSHER (WebSockets)
#===============================================================================
WPSP_LITE_PUSHER_APP_ID=
WPSP_LITE_PUSHER_APP_KEY=
WPSP_LITE_PUSHER_APP_SECRET=
WPSP_LITE_PUSHER_HOST=
WPSP_LITE_PUSHER_PORT=443
WPSP_LITE_PUSHER_SCHEME=https
WPSP_LITE_PUSHER_APP_CLUSTER=mt1

#===============================================================================
# SESSION
#===============================================================================
WPSP_LITE_SESSION_DRIVER="database"          # file|cookie|database|redis|array
WPSP_LITE_SESSION_LIFETIME=120
WPSP_LITE_SESSION_ENCRYPT=false
WPSP_LITE_SESSION_PATH=/
WPSP_LITE_SESSION_DOMAIN=
# WPSP_LITE_SESSION_SECURE_COOKIE=false

#===============================================================================
# SCOUT / MEILISEARCH / ALGOLIA (optional nếu muốn search engine)
#===============================================================================
WPSP_LITE_SCOUT_DRIVER=
WPSP_LITE_MEILISEARCH_HOST=
WPSP_LITE_MEILISEARCH_KEY=

#===============================================================================
# OCTANE (RoadRunner / Swoole) — optional nếu bạn chạy server riêng
#===============================================================================
WPSP_LITE_OCTANE_SERVER="swoole"
WPSP_LITE_OCTANE_MAX_REQUESTS=500
WPSP_LITE_OCTANE_WORKERS=4
WPSP_LITE_OCTANE_TASK_WORKERS=2

#===============================================================================
# SANCTUM / PASSPORT
#===============================================================================
WPSP_LITE_SANCTUM_STATEFUL_DOMAINS=
WPSP_LITE_SANCTUM_EXPIRATION=60
WPSP_LITE_PASSPORT_PRIVATE_KEY=
WPSP_LITE_PASSPORT_PUBLIC_KEY=

#===============================================================================
# HORIZON (Queue Dashboard)
#===============================================================================
WPSP_LITE_HORIZON_USE="redis"
WPSP_LITE_HORIZON_PREFIX="wpsp_lite_horizon_"

#===============================================================================
#  WPSP VITE
#===============================================================================
VITE_WPSP_LITE_APP_NAME="${WPSP_LITE_APP_NAME}"
VITE_WPSP_LITE_APP_SHORT_NAME="${WPSP_LITE_APP_SHORT_NAME}"
VITE_WPSP_LITE_APP_DIR_NAME="${WPSP_LITE_DIR_NAME}"

#===============================================================================
# OTHER SETTINGS
#===============================================================================
WPSP_LITE_UPDATER_PACKAGE_URL="" # https://domain.com/plugin.json